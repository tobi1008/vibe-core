<mxfile host="app.diagrams.net">
  <diagram id="pipeline" name="Autonomous Build Pipeline">
    <mxGraphModel dx="1000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Bắt đầu -->
        <mxCell id="start" value="&lt;b&gt;Bắt đầu&lt;/b&gt;&lt;br&gt;Người dùng bấm Deploy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="200" height="56" as="geometry" />
        </mxCell>

        <!-- Nhóm 1 -->
        <mxCell id="g1" value="Chuẩn bị mã nguồn" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f4f8fd;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="440" height="285" as="geometry" />
        </mxCell>
        <mxCell id="clone" value="Clone mã nguồn từ Git&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;vào workspace riêng của ứng dụng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g1">
          <mxGeometry x="80" y="45" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="heal" value="Tự sửa địa chỉ lắng nghe&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;localhost → 0.0.0.0 trong mã nguồn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g1">
          <mxGeometry x="80" y="125" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="Quét cấu trúc mã nguồn&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;cây thư mục + file lõi → ngữ cảnh cho AI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="g1">
          <mxGeometry x="80" y="205" width="280" height="56" as="geometry" />
        </mxCell>

        <!-- Nhóm 2 -->
        <mxCell id="g2" value="Sinh cấu hình bằng AI" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#f8f4fa;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="435" width="440" height="205" as="geometry" />
        </mxCell>
        <mxCell id="aigen" value="AI sinh cấu hình&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Antigravity / Claude Code → Nixpacks + manifest K3s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="g2">
          <mxGeometry x="80" y="45" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="write" value="Ghi cấu hình&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;lưu file cấu hình, vá file trong workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="g2">
          <mxGeometry x="80" y="125" width="280" height="56" as="geometry" />
        </mxCell>

        <!-- Nhóm 3 -->
        <mxCell id="g3" value="Đóng gói và triển khai" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f5faf4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="680" width="440" height="415" as="geometry" />
        </mxCell>
        <mxCell id="build" value="Build image bằng Nixpacks&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;tag theo thời điểm build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="g3">
          <mxGeometry x="80" y="45" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="buildok" value="Build&lt;br&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="g3">
          <mxGeometry x="140" y="125" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="push" value="Đẩy image lên Docker Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="g3">
          <mxGeometry x="80" y="250" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="Triển khai lên K3s&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;kubectl apply: Deployment, Service, Ingress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="g3">
          <mxGeometry x="80" y="335" width="280" height="56" as="geometry" />
        </mxCell>

        <!-- Quyết định thử lại -->
        <mxCell id="retry" value="Đã thử&lt;br&gt;đủ 3 lần?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="805" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Nhóm 4 -->
        <mxCell id="g4" value="Hermes Verifier: AI Agent kiểm tra (chỉ đọc, không sửa code, không thay đổi K3s)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1140" width="560" height="440" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="Chờ rollout&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;kiểm tra mỗi 15s, tối đa 10 phút; Ready thì theo dõi thêm 20s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g4">
          <mxGeometry x="120" y="45" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="Thu thập bằng chứng&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;trạng thái Pod, sự kiện K3s, log container, log build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g4">
          <mxGeometry x="120" y="125" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="Phân loại lỗi theo luật&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;không cần AI, làm kết luận dự phòng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g4">
          <mxGeometry x="120" y="205" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="Hermes LLM phân tích&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;chỉ ra tầng lỗi, bằng chứng và gợi ý sửa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g4">
          <mxGeometry x="120" y="285" width="320" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="Ghi báo cáo&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;vào log build, tab Hermes Check và Lịch sử&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="g4">
          <mxGeometry x="120" y="365" width="320" height="56" as="geometry" />
        </mxCell>

        <!-- Quyết định cuối -->
        <mxCell id="ready" value="Pod Ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="1620" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="K3s quyết định DONE / ERROR&lt;br&gt;(Pod có Ready hay không).&lt;br&gt;AI chỉ giải thích nguyên nhân." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#b0a24a;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="1630" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="done" value="&lt;b&gt;DONE&lt;/b&gt;&lt;br&gt;Ứng dụng online&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;domain công khai, Traefik + SSL&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="1760" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="error" value="&lt;b&gt;ERROR&lt;/b&gt;&lt;br&gt;Báo lỗi cho người dùng&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kèm bằng chứng và gợi ý sửa&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="1760" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Mũi tên -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="start" target="clone"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="clone" target="heal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="heal" target="scan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="scan" target="aigen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="aigen" target="write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="write" target="build"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="build" target="buildok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#f5faf4;" edge="1" parent="1" source="buildok" target="push"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="push" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="buildok" target="retry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="Chưa: gửi log lỗi&lt;br&gt;để AI sinh lại" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="retry" target="aigen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="508" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="Rồi (hoặc lỗi ở&lt;br&gt;bước bất kỳ phía trên)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="retry" target="h2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1293" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="deploy" target="h1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="h5" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="Có" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#4d7a3a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ready" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="Không" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ready" target="error"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" style="html=1;endArrow=none;dashed=1;strokeColor=#b0a24a;" edge="1" parent="1" source="note" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
